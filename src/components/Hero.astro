---
import { Image, Picture } from 'astro:assets';
import Icon from './Icon.astro';
import heroImage from '../assets/properties/hero-facade.jpg';
import { useTranslations, formatPriceShort } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  peek: CollectionEntry<'properties'>;
}
const { lang, peek } = Astro.props;
const t = useTranslations(lang);
const copy = peek.data[lang];
---

<section class="hero">
  <div class="hero__media" data-hero-media>
    {/*
      The Ken Burns transform sits on this wrapper, never on the <img>. An
      infinite animation directly on an <img> promotes it to its own compositor
      layer, which renders inconsistently; animating the container avoids that
      and also stops the image layer being re-rasterised each frame.
    */}
    <div class="hero__zoom" data-hero-zoom>
      {/* Picture, not Image: `formats` is a Picture prop, and AVIF is roughly
          half the weight of WebP on this photograph. */}
      <Picture
      src={heroImage}
      alt={lang === 'es'
        ? 'Villa de piedra al atardecer con piscina y jardín de palmeras'
        : 'Stone villa at sunset with a reflecting pool and palm garden'}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
        loading="eager"
        fetchpriority="high"
        data-hero-img
      />
    </div>
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__body">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">{t('hero.eyebrow')}</p>
      <h1 class="hero__title" data-split>
        {t('hero.title.a')} <em>{t('hero.title.b')}</em>
      </h1>
      <p class="hero__lead">{t('hero.lead')}</p>
      <div class="hero__actions">
        <a href="#contact" class="btn btn--primary">
          {t('hero.cta')}
          <Icon name="arrow-right" />
        </a>
        <a href="#collection" class="btn btn--ghost">{t('hero.cta2')}</a>
      </div>
    </div>

    <a href="#collection" class="peek">
      <p class="peek__label">{t('hero.peek')}</p>
      <div class="peek__row">
        <Image src={peek.data.image} alt="" width={128} height={128} loading="eager" />
        <div>
          <p class="peek__name">{copy.name}</p>
          <p class="peek__meta">{copy.area} · {formatPriceShort(peek.data.price, lang)}</p>
        </div>
      </div>
    </a>
  </div>

  <div class="cue" aria-hidden="true">
    <span>{t('hero.scroll')}</span>
    <span class="cue__line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    isolation: isolate;
    overflow: hidden;
  }

  .hero__media { position: absolute; inset: 0; z-index: -2; }

  .hero__zoom {
    width: 100%;
    height: 100%;
    transform-origin: 55% 60%;
    /*
      Deliberately NO `will-change: transform`. Pinning a full-viewport element
      into its own compositor layer for the whole session costs GPU memory and
      rendered inconsistently in testing. The animation is a slow 22s scale —
      the compositor handles it fine without the hint.
    */
  }
  .hero__zoom :global(picture) { display: block; width: 100%; height: 100%; }
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Opt IN to motion, rather than animating by default and overriding later. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__zoom { animation: kenburns 22s var(--ease-in-out-soft) infinite alternate; }
  }
  /* Paused by script once the hero scrolls away or the tab is hidden. */
  .hero__zoom[data-paused] { animation-play-state: paused; }

  @keyframes kenburns {
    from { transform: scale(1); }
    to { transform: scale(1.08); }
  }

  /* Vertical scrim for the copy, radial to sink the corners. The top stop also
     gives the transparent nav something to sit on. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(12 10 9 / 0.92) 0%, rgb(12 10 9 / 0.4) 45%, rgb(12 10 9 / 0.6) 100%),
      radial-gradient(120% 80% at 70% 40%, rgb(12 10 9 / 0) 0%, rgb(12 10 9 / 0.5) 100%);
  }

  .hero__body {
    margin-top: auto;
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: 0 var(--gutter) 6rem;
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  .hero__eyebrow { color: var(--color-bone); margin: 0 0 1rem; }
  .hero__eyebrow::before {
    content: '';
    width: 40px;
    height: 1px;
    background: var(--color-gold-hi);
  }

  .hero__title {
    font-size: var(--text-display);
    line-height: 1.05;
    margin: 0;
    max-width: 15ch;
  }
  .hero__title em { font-style: italic; color: var(--color-gold-hi); }

  .hero__lead {
    margin: 1.5rem 0 0;
    font-size: var(--text-base);
    font-weight: 300;
    color: var(--color-bone);
    opacity: 0.92;
    max-width: 46ch;
  }

  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 52px;
    padding-inline: 1.5rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--dur-base) var(--ease-out-soft),
      border-color var(--dur-base) var(--ease-out-soft),
      transform var(--dur-fast) var(--ease-out-soft);
  }
  .btn:hover { transform: translateY(-1px); }
  .btn--primary { background: var(--color-gold); color: #fff; }
  .btn--primary:hover { background: var(--color-gold-hi); }
  .btn--ghost { border-color: rgb(250 250 249 / 0.4); color: var(--color-bone); }
  .btn--ghost:hover { border-color: var(--color-bone); }

  .peek {
    display: none;
    width: 280px;
    padding: 1rem;
    border-radius: var(--radius-md);
    background: var(--glass-bg);
    border: 1px solid var(--glass-brd);
    -webkit-backdrop-filter: blur(var(--glass-blur));
    backdrop-filter: blur(var(--glass-blur));
    text-decoration: none;
    transition: transform var(--dur-base) var(--ease-out-soft);
  }
  .peek:hover { transform: translateY(-3px); }
  .peek__label {
    margin: 0 0 0.75rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-gold-hi);
  }
  .peek__row { display: flex; align-items: center; gap: 0.75rem; }
  .peek :global(img) {
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    flex: none;
  }
  .peek__name { margin: 0; font-family: var(--font-display); font-size: var(--text-base); color: var(--color-bone); }
  .peek__meta { margin: 0.25rem 0 0; font-size: var(--text-xs); color: var(--color-muted); }

  .cue {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .cue__line {
    width: 1px;
    height: 32px;
    background: linear-gradient(var(--color-gold-hi), transparent);
    animation: cue 2.4s var(--ease-in-out-soft) infinite;
    transform-origin: top;
  }
  @keyframes cue {
    0%, 100% { transform: scaleY(0.4); opacity: 0.4; }
    50% { transform: scaleY(1); opacity: 1; }
  }

  @media (min-width: 768px) {
    .hero__lead { font-size: var(--text-lg); }
    .cue { display: flex; }
  }
  @media (min-width: 1024px) {
    .hero__body { grid-template-columns: minmax(0, 1fr) auto; }
    .peek { display: block; }
  }
</style>

<script>
  // A 22s infinite loop on a full-viewport image is not free. Pause it whenever
  // the hero is offscreen or the tab is hidden.
  const zoom = document.querySelector<HTMLElement>('[data-hero-zoom]');
  if (zoom) {
    let onscreen = true;
    const sync = () => zoom.toggleAttribute('data-paused', !onscreen || document.hidden);

    new IntersectionObserver(
      ([entry]) => {
        onscreen = entry.isIntersecting;
        sync();
      },
      { threshold: 0 }
    ).observe(zoom);

    document.addEventListener('visibilitychange', sync);
    sync();
  }
</script>
