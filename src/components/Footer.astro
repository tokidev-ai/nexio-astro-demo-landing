---
import { useTranslations, localePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const nav = [
  { href: '#collection', key: 'nav.residences' },
  { href: '#story', key: 'nav.office' },
  { href: '#map', key: 'nav.journal' },
  { href: '#contact', key: 'nav.contact' },
] as const;
---

<footer class="footer">
  <div class="shell footer__grid">
    <div>
      <a href={localePath(lang)} class="brand">Nexio<span>.</span></a>
      <p class="tagline">{t('footer.tagline')}</p>
    </div>

    <nav aria-label={t('footer.nav')}>
      <h2 class="col__title">{t('footer.nav')}</h2>
      <ul>
        {nav.map((l) => <li><a href={l.href}>{t(l.key)}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="col__title">{t('footer.legal')}</h2>
      <ul>
        <li><a href="#contact">{t('footer.privacy')}</a></li>
        <li><a href="#contact">{t('footer.terms')}</a></li>
      </ul>
    </div>
  </div>

  <div class="shell footer__base">
    <p>&copy; {year} Nexio Estates. {t('footer.rights')}</p>
    <p class="credits">
      {t('footer.credits')}
      <a href="https://www.pexels.com" rel="noopener noreferrer" target="_blank">Pexels</a>
    </p>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--color-line); padding-block: 4rem 2rem; }

  .footer__grid { display: grid; gap: 2.5rem; }

  .brand {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-bone);
    text-decoration: none;
  }
  .brand span { color: var(--color-gold-hi); }
  .tagline { margin: 0.75rem 0 0; font-size: var(--text-sm); color: var(--color-muted); max-width: 34ch; }

  .col__title {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-faint);
    margin: 0 0 1rem;
  }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  ul a {
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--dur-base) var(--ease-out-soft);
  }
  ul a:hover { color: var(--color-bone); }

  .footer__base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
  .footer__base p { margin: 0; font-size: var(--text-xs); color: var(--color-faint); }
  .credits a { color: var(--color-muted); }

  @media (min-width: 768px) {
    .footer__grid { grid-template-columns: 2fr 1fr 1fr; }
  }
</style>
