---
/**
 * Lucide-style line icons, inlined. Never emoji — emoji are font-dependent and
 * cannot be themed via tokens.
 *
 * Decorative by default (`aria-hidden`). Pass a `label` only when the icon is
 * the sole carrier of meaning; then it becomes an img with an accessible name.
 */
export type IconName =
  | 'arrow-right'
  | 'arrow-down'
  | 'chevron-down'
  | 'search'
  | 'pin'
  | 'bed'
  | 'bath'
  | 'area'
  | 'close'
  | 'menu'
  | 'check'
  | 'expand';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 16, label, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  'arrow-right': '<path d="M5 12h14M12 5l7 7-7 7"/>',
  'arrow-down': '<path d="M12 5v14M19 12l-7 7-7-7"/>',
  'chevron-down': '<path d="M6 9l6 6 6-6"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>',
  pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0116 0z"/><circle cx="12" cy="10" r="3"/>',
  bed: '<path d="M2 9V5h20v4M2 13h20v6M2 19v-6M22 19v-6M6 9V7h5v2"/>',
  bath: '<path d="M4 12h16v4a4 4 0 01-4 4H8a4 4 0 01-4-4v-4zM6 12V6a2 2 0 014 0"/>',
  area: '<path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"/>',
  close: '<path d="M18 6L6 18M6 6l12 12"/>',
  menu: '<path d="M3 6h18M3 12h18M3 18h18"/>',
  check: '<path d="M20 6L9 17l-5-5"/>',
  expand: '<path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>',
};
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={paths[name]}
/>
