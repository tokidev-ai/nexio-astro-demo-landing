---
import { useTranslations, formatPriceShort } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  properties: CollectionEntry<'properties'>[];
}
const { lang, properties } = Astro.props;
const t = useTranslations(lang);

// Serialised for the island; no API key or runtime fetch is involved.
const points = properties.map((p) => ({
  id: p.id,
  name: p.data[lang].name,
  area: p.data[lang].area,
  price: formatPriceShort(p.data.price, lang),
  lng: p.data.coords.lng,
  lat: p.data.coords.lat,
}));
---

<section class="map-section" id="map">
  <div class="shell">
    <div class="head" data-reveal>
      <p class="eyebrow">{t('map.eyebrow')}</p>
      <h2 class="head__title">{t('map.title')}</h2>
      <p class="head__lead">{t('map.lead')}</p>
    </div>

    <div class="layout">
      <ul class="list" data-map-list>
        {
          points.map((p) => (
            <li>
              <button type="button" class="row" data-map-row data-id={p.id}>
                <span class="row__name">{p.name}</span>
                <span class="row__meta">
                  {p.area} · {p.price}
                </span>
              </button>
            </li>
          ))
        }
      </ul>

      <div class="map-wrap">
        <div
          class="map"
          data-map
          data-points={JSON.stringify(points)}
          role="region"
          aria-label={t('map.region')}
        >
        </div>
        <noscript>
          <p class="map__fallback">
            {lang === 'es'
              ? 'El mapa interactivo requiere JavaScript. Las cuatro zonas son Urubó Hills, Samaipata Ridge, Santa Cruz de la Sierra y Lago Tarija.'
              : 'The interactive map requires JavaScript. The four areas are Urubó Hills, Samaipata Ridge, Santa Cruz de la Sierra and Lake Tarija.'}
          </p>
        </noscript>
      </div>
    </div>
  </div>
</section>

<style>
  .map-section { padding-block: var(--section-y); }
  .eyebrow::before { content: ''; width: 40px; height: 1px; background: var(--color-gold-hi); }
  .head { margin-bottom: 2rem; }
  .head__title { margin: 0.75rem 0 0; font-size: var(--text-3xl); }
  .head__lead { margin: 1rem 0 0; font-size: var(--text-sm); color: var(--color-muted); max-width: 44ch; }

  .layout { display: grid; gap: 1.5rem; }

  .list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    width: 100%;
    min-height: 56px;
    padding: 0.75rem 1rem;
    border: 0;
    border-left: 2px solid transparent;
    background: transparent;
    text-align: left;
    color: inherit;
    font-family: var(--font-body);
    transition: background-color var(--dur-base) var(--ease-out-soft),
      border-color var(--dur-base) var(--ease-out-soft);
  }
  .row:hover,
  .row:focus-visible,
  .row.is-active {
    background: var(--color-stone);
    border-left-color: var(--color-gold-hi);
  }
  .row__name { font-family: var(--font-display); font-size: var(--text-lg); color: var(--color-bone); }
  .row__meta { font-size: var(--text-xs); color: var(--color-muted); }

  .map-wrap { position: relative; }
  .map {
    height: 420px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-line);
    background: var(--color-stone);
    overflow: hidden;
  }
  .map__fallback { padding: 1.5rem; font-size: var(--text-sm); color: var(--color-muted); }

  /* MapLibre injects its own DOM; these reach into it deliberately. */
  .map :global(.maplibregl-ctrl-attrib) {
    background: rgb(12 10 9 / 0.72);
    font-size: 10px;
  }
  .map :global(.maplibregl-ctrl-attrib a) { color: var(--color-muted); }
  .map :global(.nexio-pin) {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-gold-hi);
    border: 2px solid var(--color-ink);
    box-shadow: 0 0 0 4px rgb(202 138 4 / 0.25);
    cursor: pointer;
    transition: transform var(--dur-fast) var(--ease-out-soft),
      box-shadow var(--dur-fast) var(--ease-out-soft);
  }
  .map :global(.nexio-pin.is-active) {
    transform: scale(1.5);
    box-shadow: 0 0 0 8px rgb(202 138 4 / 0.35);
  }

  @media (min-width: 1024px) {
    .layout { grid-template-columns: 320px 1fr; align-items: start; }
    .map { height: 520px; }
  }
</style>

<script>
  import { initMap } from '../scripts/map';
  initMap();
</script>
