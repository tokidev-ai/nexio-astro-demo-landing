---
import Icon from './Icon.astro';
import { localePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const copy = {
  es: {
    eyebrow: 'Solicitud recibida',
    title: 'Gracias. Te escribimos pronto.',
    lead: 'Una persona de la oficina revisará tu solicitud y responderá en menos de un día hábil.',
    back: 'Volver al inicio',
  },
  en: {
    eyebrow: 'Request received',
    title: 'Thank you. We will be in touch.',
    lead: 'Someone from the office will review your request and reply within one business day.',
    back: 'Back to the homepage',
  },
}[lang];
---

<main id="main" class="thanks">
  <div class="shell thanks__inner">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1 class="thanks__title">{copy.title}</h1>
    <p class="thanks__lead">{copy.lead}</p>
    <a href={localePath(lang)} class="btn">
      {copy.back}
      <Icon name="arrow-right" />
    </a>
  </div>
</main>

<style>
  .thanks { min-height: 100svh; display: grid; place-items: center; }
  .thanks__inner { text-align: center; max-width: 52ch; }
  .eyebrow { justify-content: center; }
  .eyebrow::before { content: ''; width: 40px; height: 1px; background: var(--color-gold-hi); }
  .thanks__title { margin: 1rem 0 0; font-size: var(--text-4xl); }
  .thanks__lead { margin: 1.5rem auto 0; font-size: var(--text-lg); font-weight: 300; color: var(--color-muted); }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 52px;
    margin-top: 2.5rem;
    padding-inline: 1.5rem;
    border-radius: var(--radius-sm);
    background: var(--color-gold);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--dur-base) var(--ease-out-soft);
  }
  .btn:hover { background: var(--color-gold-hi); }
</style>
