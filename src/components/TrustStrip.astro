---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * `to` drives the count-up; the rendered text is already the final value, so
 * the real number is in the DOM for crawlers, screen readers, and no-JS.
 */
const stats = [
  { to: 412, prefix: '$', suffix: 'M', label: t('trust.placed'), sub: t('trust.placed.sub') },
  { to: 27, prefix: '', suffix: '', label: t('trust.years'), sub: t('trust.years.sub') },
  { to: 41, prefix: '', suffix: '', label: t('trust.days'), sub: t('trust.days.sub') },
  { to: 98, prefix: '', suffix: '%', label: t('trust.ask'), sub: t('trust.ask.sub') },
];
---

<section class="strip" data-stats>
  <div class="strip__inner shell">
    {
      stats.map((s) => (
        <div class="stat" data-reveal>
          <span class="stat__num">
            {s.prefix}<span data-count-to={s.to}>{s.to}</span><em>{s.suffix}</em>
          </span>
          <span class="stat__label">{s.label}</span>
          <span class="stat__sub">{s.sub}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .strip {
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding-block: 3rem;
  }
  .strip__inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  .stat { text-align: center; }

  .stat__num {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-bone);
    /* Without tabular figures the strip visibly reflows on every count frame. */
    font-variant-numeric: tabular-nums;
  }
  .stat__num em { font-style: normal; color: var(--color-gold-hi); }

  .stat__label {
    display: block;
    margin-top: 0.75rem;
    font-size: var(--text-xs);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .stat__sub {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--text-xs);
    color: var(--color-faint);
  }

  @media (min-width: 768px) {
    .strip { padding-block: 4rem; }
    .strip__inner { grid-template-columns: repeat(4, 1fr); }
    .stat__num { font-size: var(--text-4xl); }
  }
</style>
