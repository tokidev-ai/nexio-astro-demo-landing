---
import Icon from './Icon.astro';
import { useTranslations, localePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: '#collection', key: 'nav.residences' },
  { href: '#story', key: 'nav.office' },
  { href: '#map', key: 'nav.journal' },
  { href: '#contact', key: 'nav.contact' },
] as const;
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a href={localePath(lang)} class="brand">Nexio<span>.</span></a>

    <nav class="links" aria-label={t('nav.primary')}>
      {links.map((l) => <a href={l.href}>{t(l.key)}</a>)}
    </nav>

    <div class="lang" role="group" aria-label={t('nav.language')}>
      <a
        href={localePath('es')}
        hreflang="es"
        aria-current={lang === 'es' ? 'true' : undefined}
        class:list={['lang__btn', { 'is-on': lang === 'es' }]}>ES</a
      >
      <a
        href={localePath('en')}
        hreflang="en"
        aria-current={lang === 'en' ? 'true' : undefined}
        class:list={['lang__btn', { 'is-on': lang === 'en' }]}>EN</a
      >
    </div>

    <a href="#contact" class="cta">{t('nav.cta')}</a>

    <button
      type="button"
      class="burger"
      data-nav-toggle
      data-label-open={t('nav.open')}
      data-label-close={t('nav.close')}
      aria-expanded="false"
      aria-controls="nav-sheet"
    >
      <span class="burger__open"><Icon name="menu" size={20} /></span>
      <span class="burger__close"><Icon name="close" size={20} /></span>
      <span class="sr-only" data-nav-label>{t('nav.open')}</span>
    </button>
  </div>

  <div class="sheet" id="nav-sheet" data-nav-sheet hidden>
    {links.map((l) => <a href={l.href}>{t(l.key)}</a>)}
    <a href="#contact" class="sheet__cta">{t('nav.cta')}</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    transition: background-color var(--dur-base) var(--ease-out-soft),
      border-color var(--dur-base) var(--ease-out-soft),
      backdrop-filter var(--dur-base) var(--ease-out-soft);
    border-bottom: 1px solid transparent;
  }
  /* Past 80px the bar becomes the second (and last) glass surface. */
  .nav[data-scrolled] {
    background: var(--glass-bg);
    border-bottom-color: var(--glass-brd);
    -webkit-backdrop-filter: blur(var(--glass-blur));
    backdrop-filter: blur(var(--glass-blur));
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: 1rem var(--gutter);
  }

  .brand {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-bone);
    text-decoration: none;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .brand span { color: var(--color-gold-hi); }

  .links { display: none; gap: 1.5rem; margin-left: auto; }
  .links a {
    position: relative;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-bone);
    text-decoration: none;
    padding: 0.5rem 0;
    opacity: 0.85;
    transition: opacity var(--dur-base) var(--ease-out-soft);
  }
  .links a::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: var(--color-gold-hi);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out-soft);
  }
  .links a:hover { opacity: 1; }
  .links a:hover::after { transform: scaleX(1); }

  /* Readable over the hero photograph before the glass kicks in. */
  .nav:not([data-scrolled]) .brand,
  .nav:not([data-scrolled]) .links a {
    text-shadow: 0 1px 10px rgb(12 10 9 / 0.85);
  }

  .lang {
    display: inline-flex;
    margin-left: auto;
    padding: 2px;
    border: 1px solid var(--glass-brd);
    border-radius: 999px;
    background: rgb(12 10 9 / 0.35);
  }
  .links + .lang { margin-left: 0; }
  .lang__btn {
    min-width: 40px;
    min-height: 32px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    text-decoration: none;
    transition: background-color var(--dur-base) var(--ease-out-soft),
      color var(--dur-base) var(--ease-out-soft);
  }
  .lang__btn.is-on { background: var(--color-bone); color: var(--color-ink); }
  .lang__btn:not(.is-on):hover { color: var(--color-bone); }

  .cta {
    display: none;
    align-items: center;
    min-height: 44px;
    padding-inline: 1rem;
    border-radius: var(--radius-sm);
    background: var(--color-gold);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--dur-base) var(--ease-out-soft);
  }
  .cta:hover { background: var(--color-gold-hi); }

  .burger {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--glass-brd);
    border-radius: var(--radius-sm);
    background: rgb(12 10 9 / 0.35);
    color: var(--color-bone);
  }
  .burger__close { display: none; }
  .burger[aria-expanded='true'] .burger__open { display: none; }
  .burger[aria-expanded='true'] .burger__close { display: block; }

  .sheet {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem var(--gutter) 1.25rem;
    background: var(--color-stone);
    border-top: 1px solid var(--color-line);
  }
  .sheet[hidden] { display: none; }
  .sheet a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding-inline: 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--color-bone);
    text-decoration: none;
  }
  .sheet a:hover { background: var(--color-stone-2); }
  .sheet__cta {
    justify-content: center;
    margin-top: 0.5rem;
    background: var(--color-gold);
    color: #fff !important;
    font-weight: 600;
  }
  .sheet__cta:hover { background: var(--color-gold-hi); }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 768px) {
    .cta { display: inline-flex; }
  }
  @media (min-width: 1024px) {
    .links { display: flex; }
    .burger { display: none; }
    .sheet { display: none !important; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const sheet = document.querySelector<HTMLElement>('[data-nav-sheet]');
  const srLabel = document.querySelector<HTMLElement>('[data-nav-label]');

  // Glass-on-scroll. rAF-throttled so the scroll handler never does layout work
  // more than once a frame.
  if (nav) {
    let ticking = false;
    const sync = () => {
      nav.toggleAttribute('data-scrolled', window.scrollY > 80);
      ticking = false;
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(sync);
        }
      },
      { passive: true }
    );
    sync();
  }

  if (toggle && sheet) {
    // Labels come from the server-rendered locale, so the announced text is
    // translated rather than hardcoded English.
    const labels = {
      open: toggle.dataset.labelOpen ?? 'Open menu',
      close: toggle.dataset.labelClose ?? 'Close menu',
    };

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      sheet.hidden = !open;
      if (srLabel) srLabel.textContent = open ? labels.close : labels.open;
    };

    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true')
    );

    // Escape closes and returns focus to the trigger.
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Tapping a link inside the sheet closes it.
    sheet.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
  }
</script>
